rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE:
    // This repo did not previously contain a checked-in Firestore rules file.
    // Merge these notebook rules into your existing deployed Firestore rules
    // before rollout so unrelated lab flows keep their current access model.

    function isSignedIn() {
      return request.auth != null;
    }

    function membershipDocId(labId, userId) {
      return labId + "_" + userId;
    }

    function currentMembership(labId) {
      return get(
        /databases/$(database)/documents/memberships/$(membershipDocId(labId, request.auth.uid))
      ).data;
    }

    function membershipData(labId, userId) {
      return get(
        /databases/$(database)/documents/memberships/$(membershipDocId(labId, userId))
      ).data;
    }

    function hasActiveMembershipFor(labId, userId) {
      return isSignedIn() &&
          exists(
            /databases/$(database)/documents/memberships/$(membershipDocId(labId, userId))
          ) &&
          (
            membershipData(labId, userId).status == null ||
            membershipData(labId, userId).status == '' ||
            membershipData(labId, userId).status == 'active'
          ) &&
          (
            !('membershipEndAt' in membershipData(labId, userId)) ||
            membershipData(labId, userId).membershipEndAt == null ||
            request.time <= membershipData(labId, userId).membershipEndAt
          );
    }

    function hasActiveMembership(labId) {
      return hasActiveMembershipFor(labId, request.auth.uid);
    }

    function labData(labId) {
      return get(/databases/$(database)/documents/labs/$(labId)).data;
    }

    function labDataAfter(labId) {
      return getAfter(/databases/$(database)/documents/labs/$(labId)).data;
    }

    function isPi(labId) {
      return hasActiveMembership(labId) &&
          exists(/databases/$(database)/documents/labs/$(labId)) &&
          (
            labData(labId).piUid == request.auth.uid ||
            labData(labId).principalInvestigatorUid == request.auth.uid ||
            labData(labId).principalInvestigatorId == request.auth.uid ||
            labData(labId).ownerUid == request.auth.uid ||
            labData(labId).ownerId == request.auth.uid ||
            labData(labId).createdByUid == request.auth.uid
          );
    }

    function isPiAfter(labId) {
      return hasActiveMembership(labId) &&
          labDataAfter(labId).piUid == request.auth.uid;
    }

    function isAdmin(labId) {
      return hasActiveMembership(labId) &&
          (
            currentMembership(labId).role == 'admin' ||
            (currentMembership(labId).role == 'piAdmin' && !isPi(labId))
          );
    }

    function isPiOrAdmin(labId) {
      return isPi(labId) || isAdmin(labId);
    }

    function hasMissingPiUid() {
      return !('piUid' in resource.data) ||
          resource.data.piUid == null ||
          resource.data.piUid == '';
    }

    function hasTrustedLegacyPiUid() {
      return resource.data.principalInvestigatorUid == request.auth.uid ||
          resource.data.principalInvestigatorId == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.createdByUid == request.auth.uid;
    }

    function hasLegacyProfilePiClaim(labId) {
      return currentMembership(labId).role == 'piAdmin' &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinAs == 'PI';
    }

    function isPiUidSelfMigration(labId) {
      return hasActiveMembership(labId) &&
          hasMissingPiUid() &&
          (hasTrustedLegacyPiUid() || hasLegacyProfilePiClaim(labId)) &&
          request.resource.data.piUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['piUid']);
    }

    function isPiUidTransfer(labId) {
      return isPi(labId) &&
          request.resource.data.piUid is string &&
          request.resource.data.piUid != '' &&
          hasActiveMembershipFor(labId, request.resource.data.piUid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['piUid']);
    }

    function keepsMembershipIdentity() {
      return request.resource.data.labId == resource.data.labId &&
          request.resource.data.userId == resource.data.userId;
    }

    function hasValidMembershipTenure() {
      return request.resource.data.membershipStartAt is timestamp &&
          request.resource.data.membershipEndAt is timestamp &&
          request.resource.data.membershipEndAt >= request.resource.data.membershipStartAt;
    }

    function joinRequestPath(labId, userId) {
      return /databases/$(database)/documents/labJoinRequests/$(membershipDocId(labId, userId));
    }

    function hasApprovedJoinRequestAfter(labId, userId) {
      return existsAfter(joinRequestPath(labId, userId)) &&
          getAfter(joinRequestPath(labId, userId)).data.status == 'approved' &&
          getAfter(joinRequestPath(labId, userId)).data.labId == labId &&
          getAfter(joinRequestPath(labId, userId)).data.userId == userId &&
          getAfter(joinRequestPath(labId, userId)).data.reviewedByUid == request.auth.uid;
    }

    function isPiApprovedMemberActivation(labId, userId) {
      return isPi(labId) &&
          request.resource.data.labId == labId &&
          request.resource.data.userId == userId &&
          request.resource.data.role == 'member' &&
          request.resource.data.status == 'active' &&
          hasValidMembershipTenure() &&
          hasApprovedJoinRequestAfter(labId, userId);
    }

    function isLazyExpiryWrite() {
      return isSignedIn() &&
          request.auth.uid == resource.data.userId &&
          resource.data.status in [null, '', 'active'] &&
          ('membershipEndAt' in resource.data) &&
          resource.data.membershipEndAt < request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'expired';
    }

    function isPiMembershipRoleWrite(labId) {
      return request.resource.data.role == 'pi' &&
          request.resource.data.userId == labDataAfter(labId).piUid &&
          (isPi(labId) || isPiAfter(labId));
    }

    function isNonPiMembershipRoleWrite(labId) {
      return request.resource.data.role in ['admin', 'member'] &&
          (
            isPi(labId) ||
            isPiAfter(labId) ||
            (isAdmin(labId) &&
                resource.data.role != 'pi' &&
                labData(labId).piUid != resource.data.userId)
          );
    }

    function isPrincipalInvestigator(labId) {
      return isPi(labId);
    }

    function canReadNotebook(labId, ownerUid) {
      return hasActiveMembership(labId) &&
          (
            request.auth.uid == ownerUid ||
            isPiOrAdmin(labId)
          );
    }

    function canWriteNotebook(labId, ownerUid) {
      return hasActiveMembership(labId) &&
          request.auth.uid == ownerUid;
    }

    function validProjectShape(labId, ownerUid) {
      return request.resource.data.labId == labId &&
          request.resource.data.ownerUid == ownerUid &&
          request.resource.data.ownerEmail is string &&
          request.resource.data.createdBy is string &&
          request.resource.data.userEmail is string &&
          request.resource.data.title is string &&
          request.resource.data.description is string &&
          request.resource.data.createdAt is timestamp;
    }

    function validExperimentShape(labId, ownerUid, projectId) {
      return request.resource.data.labId == labId &&
          request.resource.data.projectId == projectId &&
          request.resource.data.ownerUid == ownerUid &&
          request.resource.data.ownerEmail is string &&
          request.resource.data.createdBy is string &&
          request.resource.data.userEmail is string &&
          request.resource.data.experimentCode is string &&
          request.resource.data.title is string &&
          request.resource.data.status is string &&
          request.resource.data.date is timestamp &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
    }

    function validNoteShape(ownerUid) {
      return request.resource.data.ownerUid == ownerUid &&
          request.resource.data.ownerEmail is string &&
          request.resource.data.createdBy is string &&
          request.resource.data.userEmail is string &&
          request.resource.data.note is string &&
          request.resource.data.createdAt is timestamp;
    }

    match /labs/{labId}/userNotebooks/{ownerUid}/projects/{projectId} {
      allow read: if canReadNotebook(labId, ownerUid);

      allow create: if canWriteNotebook(labId, ownerUid) &&
          validProjectShape(labId, ownerUid);

      allow update: if canWriteNotebook(labId, ownerUid) &&
          resource.data.labId == labId &&
          resource.data.ownerUid == ownerUid &&
          validProjectShape(labId, ownerUid);

      allow delete: if canWriteNotebook(labId, ownerUid);

      match /experiments/{experimentId} {
        allow read: if canReadNotebook(labId, ownerUid);

        allow create: if canWriteNotebook(labId, ownerUid) &&
            validExperimentShape(labId, ownerUid, projectId);

        allow update: if canWriteNotebook(labId, ownerUid) &&
            resource.data.labId == labId &&
            resource.data.projectId == projectId &&
            resource.data.ownerUid == ownerUid &&
            validExperimentShape(labId, ownerUid, projectId);

        allow delete: if canWriteNotebook(labId, ownerUid);

        match /notes/{noteId} {
          allow read: if canReadNotebook(labId, ownerUid);

          allow create: if canWriteNotebook(labId, ownerUid) &&
              validNoteShape(ownerUid);

          allow update: if canWriteNotebook(labId, ownerUid) &&
              resource.data.ownerUid == ownerUid &&
              validNoteShape(ownerUid);

          allow delete: if canWriteNotebook(labId, ownerUid);
        }
      }
    }

    match /labs/{labId} {
      allow get: if hasActiveMembership(labId);
      allow list: if isSignedIn() && request.query.limit <= 1;
      allow update: if isPiUidSelfMigration(labId) || isPiUidTransfer(labId);
    }

    match /memberships/{membershipId} {
      allow read: if hasActiveMembership(resource.data.labId);

      allow create: if isSignedIn() &&
          (
            (
              request.resource.data.userId == request.auth.uid &&
              request.resource.data.role == 'pi' &&
              labData(request.resource.data.labId).piUid == request.auth.uid
            ) ||
            (
              membershipId == membershipDocId(request.resource.data.labId, request.resource.data.userId) &&
              isPiApprovedMemberActivation(request.resource.data.labId, request.resource.data.userId)
            )
          );

      allow update: if (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']) &&
            keepsMembershipIdentity() &&
            request.resource.data.role in ['pi', 'admin', 'member'] &&
            (
              isPiMembershipRoleWrite(resource.data.labId) ||
              isNonPiMembershipRoleWrite(resource.data.labId)
            )
          ) ||
          (
            keepsMembershipIdentity() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role',
              'status',
              'userName',
              'userEmail',
              'labName',
              'membershipStartAt',
              'membershipEndAt',
              'updatedAt'
            ]) &&
            isPiApprovedMemberActivation(resource.data.labId, resource.data.userId)
          ) ||
          isLazyExpiryWrite();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /labJoinRequests/{requestId} {
      allow create: if isSignedIn() &&
          requestId == membershipDocId(request.resource.data.labId, request.auth.uid) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.labId is string &&
          request.resource.data.labId != '' &&
          !hasActiveMembership(request.resource.data.labId);

      allow read: if isSignedIn() &&
          (
            resource.data.userId == request.auth.uid ||
            isPi(resource.data.labId)
          );

      allow update: if isSignedIn() &&
          (
            (
              isPi(resource.data.labId) &&
              resource.data.status == 'pending' &&
              request.resource.data.labId == resource.data.labId &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.status in ['approved', 'rejected'] &&
              request.resource.data.reviewedByUid == request.auth.uid
            ) ||
            (
              requestId == membershipDocId(resource.data.labId, request.auth.uid) &&
              resource.data.userId == request.auth.uid &&
              resource.data.status in ['approved', 'rejected'] &&
              request.resource.data.labId == resource.data.labId &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.status == 'pending' &&
              !hasActiveMembership(resource.data.labId)
            )
          );

      allow delete: if false;
    }

    match /labs/{labId}/funds/{fundId} {
      allow read, write: if isPrincipalInvestigator(labId);

      match /transactions/{transactionId} {
        allow read, write: if isPrincipalInvestigator(labId);
      }
    }
  }
}
